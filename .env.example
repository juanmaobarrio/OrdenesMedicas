# =================================================================
# SISTEMA DE GESTIÓN DE ÓRDENES MÉDICAS - CONFIGURACIÓN DE ENTORNO
# =================================================================
# Copia este archivo como '.env' en la raíz y ajusta los valores:
# cp .env.example .env

# --- Configuración General de la Aplicación ---
PROJECT_NAME="Sistema de Gestion de Ordenes Medicas"
ENVIRONMENT=production
DEBUG=False

# --- Puertos de Servicios (ZimaBoard / Servidor) ---
# Puerto HTTP principal para acceder al frontend web (por defecto 80 o 8080)
APP_PORT=80
# Puerto expuesto para el backend API (opcional, para acceso directo o debugging)
BACKEND_PORT=8000
# Puerto expuesto de PostgreSQL (opcional para administración remota)
POSTGRES_PORT=5432

# --- Base de Datos PostgreSQL (Asyncpg) ---
POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_este_password_seguro_en_produccion_1234
POSTGRES_DB=ordenes_medicas_db

# --- Seguridad y Tokens JWT ---
# IMPORTANTE: Generar una clave secreta aleatoria de al menos 32 caracteres
SECRET_KEY=genera_aqui_una_clave_secreta_super_segura_de_al_menos_32_caracteres_aleatorios
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rendimiento del Backend (FastAPI / Uvicorn) ---
# En ZimaBoard con 2 a 4 núcleos, 2 workers ofrecen el mejor balance de consumo de RAM/CPU
UVICORN_WORKERS=2

# --- CORS (Orígenes Permitidos) ---
# Usa '*' para permitir acceso desde cualquier IP de la red local o especifica orígenes separados por coma:
# BACKEND_CORS_ORIGINS=http://localhost,http://192.168.1.100,http://zimaboard.local
BACKEND_CORS_ORIGINS=*

# --- Almacenamiento de Archivos Adjuntos (Uploads) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
